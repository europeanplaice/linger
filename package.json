{
  "name": "linger",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "workers:dev": "wrangler pages dev --proxy 5173 --port 8788 --persist-to .wrangler/local-state",
    "build": "tsc -b && tsc -p tsconfig.functions.json --noEmit && npm run build:workflows && vite build",
    "build:workflows": "tsc -p tsconfig.workflows.json --noEmit",
    "ci:local": "bash scripts/ci-local.sh",
    "test": "playwright test",
    "test:unit": "vitest run",
    "test:workers": "vitest run --config workers/s3-workflows/vitest.config.ts",
    "preview": "wrangler pages dev dist",
    "lint": "eslint src tests",
    "audit": "npm audit --audit-level=high",
    "cf:deploy": "wrangler pages deploy dist --project-name=linger --branch=main",
    "cf:deploy:staging": "wrangler pages deploy dist --project-name=linger-staging --branch=staging",
    "cf:swap-oauth": "bash scripts/swap-oauth-client.sh"
  },
  "dependencies": {
    "@github/relative-time-element": "^5.3.1",
    "aws4fetch": "^1.0.20",
    "diff": "^9.0.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.65.0",
    "motion": "^14.9.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "unicode-emoji-json": "^0.9.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.11",
    "@cloudflare/workers-types": "^5.20261030.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/react": "^16.3.3",
    "@types/google.accounts": "^0.0.18",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/ui": "^5.0.5",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-security": "^4.2.1",
    "fake-indexeddb": "^6.2.7",
    "jsdom": "^30.1.3",
    "rollup-plugin-license": "^3.7.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  },
  "overrides": {
    "esbuild": "^0.28.2",
    "ws": "^8.22.0",
    "sharp": "^0.35.5",
    "undici@^7.0.0": "^7.30.1",
    "undici@^8.0.0": "^8.12.3",
    "@cloudflare/vitest-plugin": {
      "zod": "^4.6.7"
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261023.1": true
  }
}
