{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "linger-s3-workflows-preview",
  "main": "src/index.ts",
  "workers_dev": false,
  "compatibility_date": "2026-08-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "workflows": [
    {
      "name": "s3-backfill-workflow-preview",
      "binding": "S3_BACKFILL_WORKFLOW",
      "class_name": "S3BackfillWorkflow"
    },
    {
      "name": "s3-mirror-workflow-preview",
      "binding": "S3_MIRROR_WORKFLOW",
      "class_name": "S3MirrorWorkflow"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSIONS",
      "id": "ea13bcd4fd2f4bdcba8cbbfddf7ac4f2"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "S3_SYNC_INDEX",
        "class_name": "S3SyncIndex"
      },
      {
        "name": "DIARY_WRITER",
        "class_name": "DiaryWriter"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "S3SyncIndex"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "DiaryWriter"
      ]
    }
  ],
  "secrets": {
    "required": [
      "GOOGLE_CLIENT_ID",
      "GOOGLE_CLIENT_SECRET",
      "SESSION_DOMAIN"
    ]
  },
  "vars": {
    "AUTH_KV_FALLBACK_UNTIL": "2026-12-03T09:30:25Z",
    "AUTH_KV_REVOCATION_CHECK_UNTIL": "2026-10-31T11:30:25Z"
  },
  "triggers": {
    "crons": [
      "17 * * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "linger-auth-preview",
      "database_id": "7ff5f2ac-0dd5-4ad5-8a46-4d689a279300",
      "migrations_dir": "../../migrations/auth"
    }
  ]
}
